# Copy to .env (gitignored) and export, or `set -a; source .env; set +a`.
#
# ── Local mode: everything on the devbox, no AWS bill ────────────────────────
# Destination S3 → MinIO. The three panthalassa-ocean-* buckets already exist
# there. Source reads (public NOAA/GEFS buckets) always go to real AWS and
# ignore this setting. MinIO credentials: home-server repo, .secrets/devtools.env.
WAVE_S3_ENDPOINT=http://devbox:9000
AWS_ACCESS_KEY_ID=devbox
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_DEFAULT_REGION=us-east-2

# Experiment tracking → the MLflow server on the devbox.
#   import mlflow; mlflow.autolog()   # picks this up automatically
MLFLOW_TRACKING_URI=http://devbox:5002

# ── AWS mode ─────────────────────────────────────────────────────────────────
# Leave WAVE_S3_ENDPOINT unset; boto3 falls back to the default credential
# chain (IAM role on EC2, ~/.aws/credentials locally).
